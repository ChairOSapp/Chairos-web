NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe — subscription billing (Shop Owner / Solo Chair plans)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SHOP=
STRIPE_PRICE_SOLO=

# Square — in-shop and booking-flow payments
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# Required for barber OAuth — get from Square Developer Dashboard > OAuth
SQUARE_APPLICATION_SECRET=
# Required for webhook verification — get from Square Developer Dashboard > Webhooks
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Trigger.dev — get from trigger.dev dashboard > project settings
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Anthropic — get from console.anthropic.com > API keys
ANTHROPIC_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_PLACES_API_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — ops alerts (subscriber events, payment failures, webhook
# misconfiguration, account deletion requests) post here if set.
SLACK_WEBHOOK_URL=

# Optional — Cloudflare Turnstile site key (get from
# dash.cloudflare.com/turnstile). Renders the CAPTCHA widget on
# signup/login/forgot-password when set. The matching secret key goes
# into Supabase Dashboard > Authentication > Attack Protection, not here
# — set both together, since Supabase will start requiring a captchaToken
# on every auth call the moment the secret key is added.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Same Cloudflare Turnstile widget's secret key, but for the public
# booking page (app/book/[shopCode]) -- that flow isn't a Supabase Auth
# call, so it can't use Supabase's built-in captchaToken verification.
# /api/book/verify-captcha calls Cloudflare's siteverify endpoint with
# this directly. This is the same secret value already in Supabase
# Dashboard > Authentication > Attack Protection -- Supabase doesn't
# expose it back out, so it needs to be set here too.
TURNSTILE_SECRET_KEY=

# Sentry — error tracking. Create a project at sentry.io, then set both
# DSN vars to the same value (NEXT_PUBLIC_ one is safe to expose, DSNs
# aren't secret). SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are
# optional -- without them errors still get captured, just with
# minified stack traces (no source map upload at build time).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Upstash Redis (via Vercel Marketplace "Upstash for Redis"/"KV"
# integration, or a standalone Upstash account) — backs the rate
# limiting in proxy.ts / lib/rate-limit.ts. Either naming works; the
# integration decides which one it sets.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
